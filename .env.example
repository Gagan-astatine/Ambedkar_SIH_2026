# No values are required for the current demonstration.
# Future public API origin for a production service adapter. Never place secrets here.
VITE_ARCHIVE_API_BASE_URL=

# SERVER ONLY: examples for your separately deployed backend, not browser variables.
# N8N_WEBHOOK_URL=
# N8N_WEBHOOK_SECRET=
# MODEL_API_KEY=
# DATABASE_URL=

# Portable Next.js server (Vercel, Node, Docker). Keep these server-only.
DATABASE_URL=
# Set false only for a local Postgres without TLS.
# DATABASE_SSL=false
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_SESSION_SECRET=
# Optional: the existing Sites host for originals absent from the ZIP.
ARCHIVE_SOURCE_BASE_URL=
# Development-only preview account, disabled by default.
ARCHIVE_DEV_PREVIEW_AUTH=false
